<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/berry_primary</item>
        <item name="colorOnPrimary">@color/berry_on_primary</item>
        <item name="colorSecondary">@color/berry_secondary</item>
        <item name="colorSurface">@color/berry_surface</item>
        <item name="colorOnSurface">@color/berry_text</item>
        <item name="colorOutline">@color/berry_outline</item>
        <item name="android:colorBackground">@color/berry_bg</item>
        <item name="android:windowBackground">@color/berry_bg</item>
        <item name="android:statusBarColor">@color/berry_bg</item>
        <item name="android:navigationBarColor">@color/berry_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/berry_text</item>
        <item name="materialButtonStyle">@style/Widget.Berry.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Berry.Button.Outlined</item>
    </style>

    <!-- Fullscreen focus theme — pure black, no action bar, no status bar -->
    <style name="AppTheme.Focus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Widget.Berry.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Berry.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/berry_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
